# ──────────────────────────────────────────────────────
# BLASTI API Server — Environment Variables
# ──────────────────────────────────────────────────────
# This file documents ALL environment variables used by the API server.
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────────

# ─── DATABASE ────────────────────────────────────────
# PostgreSQL connection URL (the cloud database engine).
#
# LOCAL DEVELOPMENT (start the dev database first):
#     docker compose -f ops/docker-compose.dev.yml up -d
#     postgresql://blasti:blasti@127.0.0.1:5432/blasti?schema=public
#
# PRODUCTION (OVH VPS): set through ops/.env → docker compose (see DEPLOYMENT.md):
#     postgresql://blasti:<password>@db:5432/blasti?schema=public
DATABASE_URL="postgresql://blasti:blasti@127.0.0.1:5432/blasti?schema=public"

# ─── AUTHENTICATION ──────────────────────────────────
# Secret key for signing JWT tokens (used by NextAuth.js).
# ⚠️ FOR PRODUCTION: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="blast1-dev-s3cr3t-k3y-f0r-d3v3l0pm3nt-0nly"

# ─── SERVER ──────────────────────────────────────────
# Port the API server listens on.
API_PORT="3003"

# ─── CORS / SECURITY ────────────────────────────────
# Allowed origins for Cross-Origin Resource Sharing.
# Development: "*" (allows all)
# Production: "https://blasti.yourdomain.com"
CORS_ORIGIN="*"

# Comma-separated list of allowed Socket.IO origins.
# Development: "http://localhost:3000"
# Production: "https://blasti.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"

# Secret key for internal API-to-API communication.
# ⚠️ FOR PRODUCTION: Generate with: openssl rand -base64 32
INTERNAL_SECRET="blast1-internal-secret-dev"

# ─── OPTIONAL: SMS ──────────────────────────────────
# SMS gateway API URL (if using external SMS provider)
# SMS_API_URL=""

# SMS gateway API key
# SMS_API_KEY=""

# ─── OPTIONAL: QR CODES ─────────────────────────────
# HMAC secret for QR code token signing (defaults to NEXTAUTH_SECRET)
# QR_HMAC_SECRET=""

# ─── OPTIONAL: CRON ─────────────────────────────────
# Secret token to secure the /api/cron endpoint
# CRON_SECRET=""

# ─── FILE UPLOADS ────────────────────────────────────
# Uploaded files are stored on this server's local disk under
# apps/api/uploads/ — no object-storage token is required.

# ─── OPTIONAL: REALTIME ─────────────────────────────
# URL for an external realtime service (defaults to localhost)
# REALTIME_SERVICE_URL=""

# Secret for realtime service auth
# REALTIME_SECRET=""

# ─── OPTIONAL: ENCRYPTION ───────────────────────────
# Dedicated encryption key (defaults to NEXTAUTH_SECRET)
# ENCRYPTION_KEY=""

# ─── OPTIONAL: PAYMENTS ─────────────────────────────
# Password salt for payment operations
# PASSWORD_SALT=""

# ─── OPTIONAL: FCM PUSH NOTIFICATIONS (Firebase) ────
# Enables REAL Firebase Cloud Messaging push in the notification router
# (src/lib/notification-router.ts → sendViaPushNotification). Without one of
# these variables, push is skipped gracefully (one clear log line) and the
# router falls back to SMS/WhatsApp as designed.
#
# Option 1 (RECOMMENDED): inline JSON string of the Firebase service account.
# Firebase Console → Project Settings → Service accounts → Generate new
# private key, then paste the WHOLE JSON on a single line.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'
#
# Option 2 (ALTERNATIVE): filesystem path to the service-account JSON file.
# FIREBASE_SERVICE_ACCOUNT_PATH="/secrets/blasti-firebase-service-account.json"

# ─── NODE ENV ────────────────────────────────────────
# Set to "production" for production deployment
# NODE_ENV="development"
