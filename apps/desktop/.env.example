# ──────────────────────────────────────────────────────
# BLASTI Desktop App — Environment Variables
# ──────────────────────────────────────────────────────
# This file documents ALL environment variables used by the Electron desktop app.
# Copy this to .env and fill in your values.
#
# NOTE: The desktop app is an Electron shell that loads the web app.
# Most configuration comes from the web app it connects to.
# ──────────────────────────────────────────────────────

# ─── CONNECTION ──────────────────────────────────────
# The URL the desktop app loads in production.
# In development mode (--dev flag), it uses http://localhost:3000 instead.
BLASTI_API_URL="https://blasti.vercel.app"

# ─── CLOUD SYNC API (CRITICAL — read before deploying) ───────────────
# BLASTI_CLOUD_URL is the SINGLE authoritative origin for cloud
# synchronization (initial import, /api/sync/pull, /api/sync/push,
# realtime socket). It MUST point at the machine actually running the
# sync API (apps/api — the Hono server on port 3003, usually behind a
# reverse proxy that forwards /api/* and /socket.io/*).
#
# ⚠️  https://blasti.vercel.app is the STATIC WEB EXPORT — it has NO
# /api/* routes. Pointing BLASTI_CLOUD_URL at it makes every sync call
# 404 (the startup diagnostics now detect and report this explicitly).
#
# Precedence: BLASTI_CLOUD_URL > BLASTI_API_URL > default.
# BLASTI_CLOUD_URL="https://api.your-domain.tld"

# ─── LOCAL DATABASE (single authoritative location) ─────────────────
# Optional override. Default (recommended): <userData>/blasti-local/local.db
# i.e. %APPDATA%/@blasti/desktop/blasti-local/local.db on Windows.
# Legacy databases at ~/.blasti/local are auto-migrated (copied + verified)
# to the authoritative path at first startup — the old file is kept as backup.
# BLASTI_LOCAL_DB_DIR=""

# ─── LAN SERVER ─────────────────────────────────────
# Comma-separated list of allowed CORS origins for the LAN server (port 3080).
# This controls which devices on the local network can connect.
# Development: "http://localhost:3000"
# Production: "http://192.168.1.100:3000,http://192.168.1.50:3000"
# BLASTI_LAN_ORIGINS="http://localhost:3000"

# ─── AUTHENTICATION ──────────────────────────────────
# Secret for JWT signing on the LAN server.
# Should match NEXTAUTH_SECRET from the web/API .env files.
# NEXTAUTH_SECRET="blast1-dev-s3cr3t-k3y-f0r-d3v3l0pm3nt-0nly"

# ─── DEVELOPMENT ─────────────────────────────────────
# Set ELECTRON_DEV=1 or pass --dev flag to run in development mode.
# This loads http://localhost:3000 instead of the production URL.
# ELECTRON_DEV="1"
# NODE_ENV="development"
