{
  "name": "@blasti/desktop",
  "version": "0.6.46",
  "private": true,
  "description": "BLASTI Desktop — Multi-agency queue management system",
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "dev:verbose": "electron . --dev --enable-logging",
    "prebuild": "node scripts/prebuild.js",
    "build": "node scripts/prebuild.js && electron-builder --publish never",
    "build:win": "node scripts/prebuild.js && electron-builder --publish never --win",
    "build:mac": "node scripts/prebuild.js && electron-builder --publish never --mac",
    "build:linux": "node scripts/prebuild.js && electron-builder --publish never --linux",
    "build:all": "node scripts/prebuild.js && electron-builder --publish never --mac --win --linux",
    "build:export": "bun run --filter @blasti/web build:export",
    "build:portable": "node scripts/prebuild.js && electron-builder --publish never --dir"
  },
  "dependencies": {
    "@blasti/binary-delta": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^2.4.3",
    "electron-is-dev": "^3.0.1",
    "hono": "^4.12.32",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "prisma": "^6.11.1"
  },
  "homepage": "https://github.com/raizel820/BLASTI-MULTI-PLATFORM",
  "author": {
    "name": "BLASTI Team",
    "email": "admin@blasti.dz"
  }
}
