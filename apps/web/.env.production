# ════════════════════════════════════════════════════════════════
# BLASTI web — build-time environment (production / static export)
# ════════════════════════════════════════════════════════════════
# READ BY:  `next build` only — i.e. `bun run build:export`,
#           `bun run build:mobile`, `bun run build:desktop`.
# IGNORED BY: `bun run dev` — the dev server never loads this file.
#
# NEXT_PUBLIC_* values are BAKED INTO the JS bundle at build time.
# After changing anything here you MUST rebuild the mobile bundle:
#
#     bun run build:mobile        # web export + cap sync android
#     bun run mobile:studio       # then ▶ Run in Android Studio
#
# (Pressing ▶ Run alone in Android Studio does NOT refresh the bundle.)
#
# NOTE: even with this file missing, the Capacitor code now falls back
# to http://10.0.2.2:3003 (emulator alias) instead of localhost — so an
# emulator build works out of the box either way.
# ════════════════════════════════════════════════════════════════

# ── ANDROID EMULATOR (current default) ──────────────────────────
# 10.0.2.2 = the emulator's alias for your PC's localhost, where the
# API (bun run dev) listens on :3003.
NEXT_PUBLIC_API_URL=http://10.0.2.2:3003

# ── PHYSICAL PHONE on the same Wi-Fi ────────────────────────────
# Comment out the emulator line above, uncomment this, and use your
# PC's LAN IP (ipconfig → IPv4 address, e.g. 192.168.1.100):
# NEXT_PUBLIC_API_URL=http://192.168.1.100:3003

# ── REAL SERVER (production deployment) ─────────────────────────
# When the API is deployed with HTTPS, point this at that origin:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
#
# If you deploy the WEB app publicly while the API lives elsewhere,
# put a machine-specific override in .env.production.local (higher
# priority, never committed).
