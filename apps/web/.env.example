# ──────────────────────────────────────────────────────
# BLASTI Web App — Environment Variables
# ──────────────────────────────────────────────────────
# This file documents ALL environment variables used by the Next.js web app.
# Copy this to .env and fill in your values.
#
# NOTE: Next.js automatically loads .env files from the app directory.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Variables WITHOUT the prefix are server-side only (kept secret).
# ──────────────────────────────────────────────────────

# ─── DATABASE ────────────────────────────────────────
# Path to the SQLite database file (needed by NextAuth.js server-side).
# IMPORTANT: This path is relative to the project ROOT.
DATABASE_URL="file:./packages/db/data/custom.db"

# ─── AUTHENTICATION ──────────────────────────────────
# Secret key for NextAuth.js session encryption.
# Must match the API server's NEXTAUTH_SECRET!
# ⚠️ FOR PRODUCTION: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="blast1-dev-s3cr3t-k3y-f0r-d3v3l0pm3nt-0nly"

# The base URL of the web app.
# Development: http://localhost:3000/
# Production: https://blasti.yourdomain.com
NEXTAUTH_URL="http://localhost:3000/"

# ─── API CONNECTION ──────────────────────────────────
# Port where the API server runs (used by next.config.ts rewrites)
API_PORT="3003"

# ─── CLIENT-SIDE (BROWSER) VARIABLES ────────────────
# These are prefixed with NEXT_PUBLIC_ and are visible in the browser.

# URL for the API server (used by native shells that can't use same-origin requests)
# Leave empty when the web app and API run behind the same reverse proxy.
# For split deployments: "https://api.your-domain.com"
# NEXT_PUBLIC_API_URL=""

# URL for real-time Socket.IO connection (optional, defaults to same host)
# NEXT_PUBLIC_REALTIME_URL=""

# Token for real-time connection authentication (optional)
# NEXT_PUBLIC_REALTIME_TOKEN=""

# Public URL of the app (used for QR codes and sharing links)
# NEXT_PUBLIC_APP_URL="https://blasti.dz"

# ─── BUILD MODE ──────────────────────────────────────
# Set to "export" for static export (needed for Capacitor mobile app builds)
# NEXT_BUILD_MODE="export"

# ─── SERVER-SIDE ONLY ───────────────────────────────
# Internal API URL (for server-to-server calls, bypassing the proxy)
# INTERNAL_API_URL="http://localhost:3003"

# Realtime service URL (for server-side event emission)
# REALTIME_SERVICE_URL="http://localhost:3003"

# Realtime service secret
# REALTIME_SECRET=""
