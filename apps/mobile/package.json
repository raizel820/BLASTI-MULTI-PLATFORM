{
  "name": "@blasti/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "echo 'Run bun run dev:web and then cap:sync'",
    "studio": "cap open android",
    "open:ios": "cap open ios",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "build:web": "bun run --filter @blasti/web build:export",
    "build:android": "bun run --filter @blasti/web build:export && cap sync android && cap open android",
    "build:android:release": "bun run --filter @blasti/web build:export && cap sync android && node ../../scripts/gradle.js assembleRelease",
    "build:android:debug": "bun run --filter @blasti/web build:export && cap sync android && node ../../scripts/gradle.js assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "cross-env": "^7.0.3"
  }
}
