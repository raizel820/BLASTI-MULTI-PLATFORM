<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- NOTE: android:showWhenLocked / android:turnScreenOn were
                 REMOVED on purpose (field report: "the whole mobile app still
                 shows on the lock screen"). With the static attrs present,
                 ANY foregrounding of the activity — tapping the turn-alert
                 notification on the lock screen, a full-screen intent, a deep
                 link — painted the ENTIRE app over the keyguard. Now the app
                 can never appear above the lock screen; only the system
                 NOTIFICATION does (IMPORTANCE_HIGH + VISIBILITY_PUBLIC on the
                 blasti-lockscreen / blasti-turn-alert channels). The opt-in
                 "full-screen call takeover" preference is applied at runtime
                 by MainActivity → BlastiNativeStatus.applyLaunchPreferences()
                 (setShowWhenLocked/setTurnScreenOn, default false) so the
                 legacy behavior remains available ONLY when explicitly enabled
                 in Settings → Notifications. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link scheme for blasti:// URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="blasti" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Swipe-to-stop / "Stop" action receiver for the lock-screen turn
             notification. Not exported — only the app's own PendingIntents can
             reach it. Records the dismissal + cancels vibration so the web
             layer can drop the pending in-app replay on resume. -->
        <receiver
            android:name=".BlastiNotificationDismissReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <!-- Network access for API calls and Socket.IO -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS / location for nearby agencies and map picker (@capacitor/geolocation) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Haptic feedback for turn alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera for QR code scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Wake device screen when a turn is called -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Full-screen intent for turn alert over lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Push/local notifications (required on Android 13+ / API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- In-app update delivery: install the APK downloaded from the BLASTI
         cloud (Public App Settings pusher). Android 8+ shows its own
         "allow from this source" consent screen on first install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
