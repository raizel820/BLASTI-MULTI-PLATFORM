<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- App-update delivery: update APKs land in
         Android/data/com.blasti.mobile/files/Download (DownloadManager) and
         are shared to the system package installer via this FileProvider. -->
