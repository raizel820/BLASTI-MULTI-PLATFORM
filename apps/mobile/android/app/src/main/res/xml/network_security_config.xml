<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      BLASTI Mobile — Network Security Config (DEBUG)

      Debug builds permit cleartext (HTTP) everywhere so the app can be tested
      against a local dev stack: the Express API (default :3003) on this
      machine's LAN IP, the Android-Emulator host alias 10.0.2.2, mDNS names
      (blasti.local), and the desktop local-api (:3080) discovered on the LAN.

      The release variant OVERRIDES this file wholesale via
      src/release/res/xml/network_security_config.xml (cleartext forbidden,
      system CAs only) — Google Play compliant, do not weaken that one.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- System CAs + user-installed CAs so proxy debugging
                 (Charles / mitmproxy / HTTP Toolkit) works on debug builds -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
