<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- BLASTI emerald branding -->
        <item name="colorPrimary">#10b981</item>
        <item name="colorPrimaryDark">#059669</item>
        <item name="colorAccent">#14b8a6</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 0.6.127 — the activity theme had NO windowBackground: whatever gap
             appears before the WebView paints (hydration, webview reload,
             renderer recovery) showed the raw window color — BLACK on phones
             in system dark mode (DayNight parent), white otherwise. The
             brand splash drawable makes every such gap read as intentional. -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
