{
	"appId": "com.blasti.mobile",
	"appName": "BLASTI",
	"webDir": "../../apps/web/out",
	"server": {
		"url": "http://192.168.100.5:3000",
		"cleartext": true,
		"androidScheme": "http"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#10b981",
			"showSpinner": true,
			"spinnerColor": "#ffffff",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#10b981"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_blasti",
			"iconColor": "#10b981",
			"sound": "default"
		},
		"Camera": {
			"presentationStyle": "fullscreen"
		},
		"App": {
			"launchUrl": "blasti://"
		}
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#FFFFFF"
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#FFFFFF"
	}
}
