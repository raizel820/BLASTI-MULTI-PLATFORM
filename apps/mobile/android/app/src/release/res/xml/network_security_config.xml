<?xml version="1.0" encoding="utf-8"?>
<!--
  BLASTI Mobile — Network Security Config (RELEASE)

  This file lives at src/release/res/xml/network_security_config.xml and is
  automatically picked up only by release builds (Gradle overlays src/release/
  on top of src/main/ when building the release variant). It overrides the
  permissive debug config at src/main/res/xml/network_security_config.xml.

  Task 70 (phone audit): release builds previously forbade ALL cleartext
  traffic — correct once the server serves HTTPS, but until the domain+TLS
  migration the production VPS was plain HTTP behind Caddy on port 80, so
  every release APK failed with net::ERR_CLEARTEXT_NOT_PERMITTED while the
  debug APK (permissive main config) worked. allowMixedContent in
  capacitor.config.ts CANNOT grant this — cleartext is enforced by the
  network stack, not the WebView.

  Current policy (HTTPS-ONLY, 0.6.36):
    - HTTPS everywhere, system CAs only. New builds are locked to
      https://blastidz.online (Let's Encrypt on the VPS).
    - The temporary cleartext exception for the raw cloud VPS IP has been
      REMOVED — the migration to the domain is complete, so release builds
      now refuse cleartext to ANY host (mitm-safe).
    - The debug variant remains fully permissive (separate file).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
