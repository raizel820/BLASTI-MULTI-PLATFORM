<?xml version="1.0" encoding="utf-8"?>
<!--
  BLASTI Mobile — Network Security Config (RELEASE)

  This file lives at src/release/res/xml/network_security_config.xml and is
  automatically picked up only by release builds (Gradle overlays src/release/
  on top of src/main/ when building the release variant). It overrides the
  permissive debug config at src/main/res/xml/network_security_config.xml.

  Release builds MUST NOT allow cleartext HTTP traffic:
    - Enforces HTTPS for all API calls, Socket.IO, and the WebView itself.
    - Only trusts the system CA store (no user-installed certs) to prevent
      man-in-the-middle attacks on production devices.
    - This is required for Google Play policy compliance and for secure-context
      browser APIs (Payment Request, Geolocation, Service Workers) which the
      production app relies on (androidScheme: 'https').
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
