<?xml version="1.0" encoding="utf-8"?>
<!--
  BLASTI Mobile — Network Security Config (RELEASE)

  This file lives at src/release/res/xml/network_security_config.xml and is
  automatically picked up only by release builds (Gradle overlays src/release/
  on top of src/main/ when building the release variant). It overrides the
  permissive debug config at src/main/res/xml/network_security_config.xml.

  Task 70 (phone audit): release builds previously forbade ALL cleartext
  traffic — correct once the server serves HTTPS. The cloud is now locked to
  https://blastidz.online (Let's Encrypt on the VPS), so cloud traffic is
  TLS-protected and system-CA-validated.

  0.6.86 (kiosk mode on phones/tablets — USER REQUEST): the kiosk features
  REQUIRE plain-HTTP calls to the BLASTI DESKTOP's local API on the LAN
  (http://192.168.x.x:3080 — discovery beacon probe, pairing, live queue,
  ticket printing). Android's network stack cannot express "cleartext only
  for RFC1918 subnets" in this file (no IP-range rules exist), so cleartext
  is permitted globally while the certificate trust stays strict
  (system CAs ONLY — no user CAs). Practical exposure: cleartext is
  MITM-readable on hostile public Wi-Fi, but the app sends no credentials in
  cleartext beyond the kiosk deviceToken scoped to queue operations, and the
  cloud API itself is always https. This restores the phone/tablet kiosk
  capability that release builds have been missing since 0.6.36
  (net::ERR_CLEARTEXT_NOT_PERMITTED on every LAN call).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
