# ════════════════════════════════════════════════════════════════
# BLASTI — OVHcloud production environment (docker compose reads this)
# ════════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. cp .env.example .env      (inside the ops/ folder)
#   2. Edit EVERY value marked ⚠️ below
#   3. docker compose up -d --build
# This file contains secrets — NEVER commit ops/.env to git.
# ════════════════════════════════════════════════════════════════

# ─── POSTGRESQL (database) ───────────────────────────────────────
# ⚠️ Pick a LONG random password. It stays inside the server.
#    Generate one:  openssl rand -base64 24
POSTGRES_USER=blasti
POSTGRES_PASSWORD=CHANGE-ME-long-random-password
POSTGRES_DB=blasti

# ─── SECURITY SECRETS ────────────────────────────────────────────
# ⚠️ Session-signing key. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE-ME-openssl-rand-base64-32

# ⚠️ Internal API-to-API secret. Generate: openssl rand -base64 32
INTERNAL_SECRET=CHANGE-ME-too

# Optional: secret for the /api/cron maintenance endpoint
# CRON_SECRET=

# ─── PUBLIC ADDRESS ──────────────────────────────────────────────
# What people type in the browser.
#
# With a domain (recommended — Caddy fetches a free HTTPS certificate
# automatically once the DNS A-record points at your VPS):
SITE_ADDRESS=https://blasti.example.com
#
# WITHOUT a domain (testing on the raw VPS IP — plain HTTP, no TLS):
#   SITE_ADDRESS=:80

# ─── CORS / REALTIME ORIGINS ─────────────────────────────────────
# Must match where the web app is served from. With a domain:
CORS_ORIGIN=https://blasti.example.com
ALLOWED_ORIGINS=https://blasti.example.com
#
# Without a domain (IP testing):
#   CORS_ORIGIN=http://203.0.113.10
#   ALLOWED_ORIGINS=http://203.0.113.10
# (Multiple origins: comma-separate them. Native shells — capacitor://localhost,
#  http://localhost, file:// — are always allowed automatically by the API.)
