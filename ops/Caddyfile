# ════════════════════════════════════════════════════════════════
# BLASTI — public gateway (Caddy 2)
# ════════════════════════════════════════════════════════════════
# SITE_ADDRESS is injected from ops/.env via docker-compose.yml:
#   • https://blasti.example.com  → automatic Let's Encrypt HTTPS
#   • :80                         → plain HTTP (IP-only testing)
#
# www SUBDOMAIN: the native VPS installer (render_caddyfile() in
# scripts/deploy-oracle-vps.sh) APPENDS a second site block for
# www.<domain> — its own auto-TLS certificate + a 308 redirect of every
# path to the canonical apex origin. Docker stacks can add the same
# block manually if they want the alias.
#
# Works in BOTH deployment architectures (see DEPLOY-GUIDE.md):
#   • Docker stack (ops/docker-compose.yml): the docker-compose
#     `api`/`web` service names are used as-is.
#   • Native VPS stack (deploy-oracle-vps.sh install):
#     the installer rewrites api:3003 / web:3000 → 127.0.0.1:3003 /
#     127.0.0.1:3000 and bakes SITE_ADDRESS into /etc/caddy/Caddyfile.
#
# Caddy handles WebSocket upgrades automatically, so the realtime
# socket and the REST API share the same public origin as the web
# app — no CORS headaches, native shells always allowed by the API.
#
# 0.6.80 FIX — the 0.6.79 route/handle restructure put TWO path tokens on
# the handle line (`handle /a /b {`), but a Caddyfile directive accepts only
# ONE matcher token: caddy aborted with "wrong argument count or unexpected
# line ending" and every VPS deploy kept dying at `caddy validate`. Multiple
# paths must live in a NAMED matcher (`@name path /a /b`), which the handle
# then references with its single matcher token. The named matcher is
# declared inside the site block (request matchers may not be defined
# globally) and referenced from the route block below.
# ════════════════════════════════════════════════════════════════

{$SITE_ADDRESS} {
        # SPEED ROUND 2 — binary downloads bypass compression. Installers +
        # delta patches are pre-compressed opaque octet-streams; gzip/zstd on
        # the fly only burns VPS CPU per streamed byte and can cap throughput
        # below the client's line rate. This handle is evaluated FIRST inside
        # the route (handle blocks are mutually exclusive, first match wins),
        # so download responses stream raw byte-for-byte. `*` matches ONE
        # segment — the delta route has an extra `/delta/<id>/` hop, hence
        # the second pattern.
        @binaryDownloads path /api/app-versions/*/download /api/app-versions/delta/*/download

        route {
                # ── SECURITY (0.6.126 audit T1-4): gateway security headers ──
                # Applied to every proxied response (web + API). The upstreams
                # also set these now; `defer` lets upstream values win when
                # they differ. HSTS is safe: Caddy auto-HTTPS guarantees TLS
                # on every site block using a domain SITE_ADDRESS.
                header {
                        X-Content-Type-Options "nosniff"
                        X-Frame-Options "DENY"
                        Referrer-Policy "strict-origin-when-cross-origin"
                        Strict-Transport-Security "max-age=31536000; includeSubDomains"
                        defer
                }

                # ── Binary downloads bypass compression (SPEED ROUND 2) ──
                handle @binaryDownloads {
                        reverse_proxy api:3003 {
                                flush_interval -1
                        }
                }

                # Compression for text responses (JSON/HTML/JS/CSS).
                encode zstd gzip

                # API (Bun, :3003) — REST endpoints.
                # NOTE: response caching/compression policy is set by the API
                # itself (ETag + Cache-Control middleware). Caddy only
                # compresses on the way out; it never re-compresses an
                # already-encoded response.
                # flush_interval -1 → byte frames reach the client the moment
                # the API emits them (no proxy write-buffering — the desktop
                # updater downloads each delta hop over several short ranged
                # requests where every buffered ms is visible).
                handle /api/* {
                        reverse_proxy api:3003 {
                                flush_interval -1
                        }
                }

                # API — realtime engine.io/socket.io handshake + transports.
                # flush_interval -1 → every frame is forwarded the moment it
                # arrives (no proxy buffering on long-poll fallback transports).
                handle /socket.io/* {
                        reverse_proxy api:3003 {
                                flush_interval -1
                        }
                }

                # Everything else → Next.js web app (:3000)
                handle {
                        # ── Performance Round — static asset caching ─────────
                        # Fingerprinted build chunks already carry immutable
                        # caching from Next itself. Everything below overrides
                        # the upstream's `max-age=0` for public/ assets;
                        # `defer` makes our value win over the header the Next
                        # server just set.
                        #
                        # Icons/images/fonts/manifest/audio: 7 days (content
                        # changes are rare and redeploy-busting is acceptable
                        # for them).
                        @staticAssets {
                                path *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.avif
                                path *.woff *.woff2 *.ttf *.otf *.eot
                                path *.webmanifest *.wav *.mp3
                        }
                        header @staticAssets {
                                Cache-Control "public, max-age=604800"
                                defer
                        }

                        reverse_proxy web:3000
                }
        }
}
