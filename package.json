{
  "name": "blasti-multiplatform",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "bun scripts/dev-web.mjs",
    "dev:web:legacy": "bun run --filter @blasti/web dev",
    "dev:api": "bun run db:push && cd apps/api && bun --hot src/index.ts",
    "dev:all": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "start": "concurrently -n api,web -c blue,green \"bun run start:api\" \"bun run start:web\"",
    "start:web": "bun run --filter @blasti/web start",
    "start:api": "cd apps/api && bun src/index.ts",
    "build": "bun run --filter @blasti/web build",
    "build:api": "bun run --filter @blasti/api build",
    "build:all": "bun run --filter @blasti/web build && bun run --filter @blasti/api build",
    "build:export": "cd apps/web && cross-env NEXT_BUILD_MODE=export next build",
    "build:desktop": "bun run build:export && bun run --filter @blasti/desktop build",
    "build:mobile": "bun run build:export && bun run --filter @blasti/mobile cap:sync:android",
    "lint": "cd apps/web && eslint .",
    "db:push": "cross-env DATABASE_URL=file:../data/custom.db bun run --filter @blasti/db db:push",
    "db:generate": "bun run --filter @blasti/db db:generate",
    "db:migrate": "cross-env DATABASE_URL=file:../data/custom.db bun run --filter @blasti/db db:migrate",
    "db:reset": "cross-env DATABASE_URL=file:../data/custom.db bun run --filter @blasti/db db:reset",
    "db:seed": "cross-env DATABASE_URL=file:../data/custom.db bun run --filter @blasti/db db:seed",
    "db:studio": "bun run --filter @blasti/db db:studio",
    "reset:all": "bun run scripts/reset-all.ts",
    "reset:cloud": "bun run scripts/reset-all.ts --cloud-only",
    "reset:desktop": "bun run scripts/reset-all.ts --desktop-only",
    "reset:files": "bun run scripts/reset-all.ts --files-only",
    "cap:sync": "bun run --filter @blasti/mobile cap:sync",
    "electron:dev": "cd apps/desktop && npx electron . --dev",
    "electron:dev:bun": "bun run --filter @blasti/desktop dev",
    "electron:dev:full": "concurrently -n api,web,desktop -c blue,green,yellow \"bun run dev:api\" \"bun run dev:web\" \"cd apps/desktop && npx electron . --dev\"",
    "electron:build": "bun run --filter @blasti/desktop build",
    "electron:build:win": "bun run --filter @blasti/desktop build:win",
    "electron:build:mac": "bun run --filter @blasti/desktop build:mac",
    "electron:build:linux": "bun run --filter @blasti/desktop build:linux"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
