# ──────────────────────────────────────────────────────
# BLASTI (بلاصتي) — Environment Variables Template
# ──────────────────────────────────────────────────────
#
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to ".env"
#    Command: cp .env.example .env
# 2. Fill in the values for your setup
# 3. Never commit the .env file to version control (it's in .gitignore)
#
# EACH APP ALSO HAS ITS OWN .env.example:
#   apps/api/.env.example      → API server specific variables
#   apps/web/.env.example      → Web app specific variables
#   apps/desktop/.env.example  → Desktop app specific variables
#   apps/mobile/.env.example   → Mobile app specific variables
#
# For basic setup, this root .env is all you need.
# For advanced per-app configuration, copy the respective .env.example too.
#
# ──────────────────────────────────────────────────────

# ─── DATABASE ────────────────────────────────────────
# Path to the SQLite database file.
# This path is RELATIVE to the project root folder.
# The database file will be created automatically when you run: bun run db:push
DATABASE_URL="file:./packages/db/data/custom.db"

# ─── AUTHENTICATION ──────────────────────────────────
# Secret key for encrypting user login sessions (NextAuth.js).
# ⚠️ FOR PRODUCTION: Change this to a strong random string!
#    Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="blast1-dev-s3cr3t-k3y-f0r-d3v3l0pm3nt-0nly"

# The URL where your web app runs.
# Development: http://localhost:3000/
# Production: https://blasti.yourdomain.com
NEXTAUTH_URL="http://localhost:3000/"

# ─── API SECURITY ────────────────────────────────────
# Which websites are allowed to call your API (CORS).
# Development: "*" (allows all websites)
# ⚠️ FOR PRODUCTION: Set to your actual domain!
CORS_ORIGIN="*"

# Secret key for internal API-to-API communication.
# ⚠️ FOR PRODUCTION: Change this to a strong random string!
#    Generate one with: openssl rand -base64 32
INTERNAL_SECRET="blast1-internal-secret-dev"

# ─── SERVER PORTS ────────────────────────────────────
# Port for the API server (default: 3003)
# API_PORT="3003"

# ─── SOCKET.IO ORIGINS ──────────────────────────────
# Allowed origins for WebSocket connections.
# ALLOWED_ORIGINS="http://localhost:3000"

# ─── OPTIONAL: PUBLIC APP URL ───────────────────────
# Used for generating QR codes and share links.
# NEXT_PUBLIC_APP_URL="https://blasti.dz"

# ─── OPTIONAL: CLIENT-SIDE API URL ──────────────────
# For mobile/desktop apps that can't use Next.js rewrites.
# NEXT_PUBLIC_API_URL=""

# ─── OPTIONAL: REALTIME ─────────────────────────────
# NEXT_PUBLIC_REALTIME_URL=""
# NEXT_PUBLIC_REALTIME_TOKEN=""

# ─── OPTIONAL: DESKTOP APP ──────────────────────────
# BLASTI_API_URL="https://blasti.vercel.app"
# BLASTI_LAN_ORIGINS="http://localhost:3000"

# ─── OPTIONAL: MOBILE APP DEV ───────────────────────
# CAPACITOR_SERVER_URL="http://192.168.1.100:3000"

# ─── OPTIONAL: SMS GATEWAY ──────────────────────────
# SMS_API_URL=""
# SMS_API_KEY=""

# ─── OPTIONAL: FILE UPLOADS ─────────────────────────
# BLOB_READ_WRITE_TOKEN=""
# NEXT_PUBLIC_R2_PUBLIC_URL=""
