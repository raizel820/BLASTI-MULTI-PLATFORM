# ──────────────────────────────────────────────────────────────
# @blasti/db — Prisma CLI default environment (COMMITTED ON PURPOSE)
# ──────────────────────────────────────────────────────────────
# This file gives the Prisma CLI (db push / migrate / studio) the local
# development database WITHOUT any manual setup. It matches the dev
# PostgreSQL instance from:
#
#     docker compose -f ops/docker-compose.dev.yml up -d
#
# PRECEDENCE: a real DATABASE_URL environment variable ALWAYS wins over
# this file — production (OVH VPS) sets it through ops/.env and nothing
# here is used. No secret lives in this file (localhost-only credentials).
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://blasti:blasti@127.0.0.1:5432/blasti?schema=public"
